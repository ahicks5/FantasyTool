# Edge web (web/) — copy to .env.local and fill in. Every NEXT_PUBLIC_* value is
# inlined into the browser bundle at build time, so none of them may be a secret.

# --- API -----------------------------------------------------------------------------
# Base URL of the Edge API. Leave it UNSET and the whole app runs on the mock data in
# src/lib/mocks.ts, which is how the static demo works.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Dev only: send this as X-Edge-User instead of signing in. Requires EDGE_DEV=1 on the
# API. Leave blank in production.
NEXT_PUBLIC_DEV_USER=

# --- Public URL ----------------------------------------------------------------------
# Where this site lives. Next resolves Open Graph images against it, so leaving it unset
# makes every share link unfurl as nothing — and a pasted trade verdict is the whole
# distribution plan. Vercel's own VERCEL_URL is used as a fallback, but it is the
# per-deployment hostname, not the domain people actually visit, so set this.
NEXT_PUBLIC_SITE_URL=

# --- Auth ----------------------------------------------------------------------------
# From your Supabase project. The anon key is publishable by design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Legal and support ---------------------------------------------------------------
# Stripe's live-mode review asks for a reachable contact and a stated refund policy,
# so /terms and /privacy need these before you can take real money.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Shown as "In effect from ...", e.g. 18 September 2026.
NEXT_PUBLIC_LEGAL_EFFECTIVE=
# Who is on the hook: a legal entity, or the name the business trades under.
NEXT_PUBLIC_LEGAL_OPERATOR=Edge
# Governing law, e.g. "the State of Indiana, USA". Left blank, the clause is omitted,
# which is better than guessing one.
NEXT_PUBLIC_LEGAL_JURISDICTION=
# Days a customer has to ask for a refund, no questions asked.
NEXT_PUBLIC_REFUND_DAYS=14

# --- Demo build (set by `npm run demo`; you do not set these by hand) -----------------
# EDGE_DEMO_EXPORT=1   static export, share page pre-rendered
# NEXT_PUBLIC_EDGE_DEMO=1   a league pre-connected so the link opens on the feed
