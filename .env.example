# Edge API (edge/) — copy to .env and fill in. Nothing here is required to run the
# tests, which are offline against fixtures; the API itself runs with all of it unset.
# Secrets belong in the host's environment settings (Railway/Render), never in git.

# --- Where things live -------------------------------------------------------------
# Public URL of the web app. Used for share links, and to decide which checkout return
# URLs are ours — an off-origin one is refused, so this must be right in production.
EDGE_WEB_URL=http://localhost:3000
# Comma-separated allowed browser origins. Unset, it falls back to EDGE_WEB_URL, and
# then to localhost — never to "*", which would let any page on the internet call this
# API from a visitor's browser with their ESPN cookies attached.
EDGE_CORS=
# Postgres connection string (Supabase gives you one). Set this and it is used instead
# of SQLite. Anything taking real money should: purchases are the row you cannot afford
# to lose, and a container's disk is one machine with no backups.
DATABASE_URL=
# SQLite file, used when DATABASE_URL is empty. Zero setup, right for local work.
EDGE_DB=.cache/edge.db
# Disk cache for the Sleeper player list, projections and rendered share cards.
EDGE_CACHE_DIR=.cache

# --- Abuse and cost control ---------------------------------------------------------
# Per-IP caps per minute. The league endpoints are open by design (a stranger can see
# their moves before signing up), which also means anyone can make us fetch from Sleeper
# and ESPN as fast as they can ask. Set EDGE_RATE_LIMIT=0 only for local work.
EDGE_RATE_LIMIT=1
EDGE_RATE_LEAGUE=60
EDGE_RATE_ALL=300
# Set to 1 when a proxy you trust is in front (Railway, Render, a CDN). Only then is
# X-Forwarded-For believed; without a proxy it is forgeable, and with one every request
# otherwise appears to come from the proxy and shares a single bucket.
EDGE_TRUST_PROXY=

# --- Season ------------------------------------------------------------------------
EDGE_SEASON=2026

# --- Auth --------------------------------------------------------------------------
# Supabase JWT signing secret; the API verifies the browser's bearer token with it.
# Without it, a signed-in request is rejected with a 500 rather than trusted.
SUPABASE_JWT_SECRET=
# Dev only: with EDGE_DEV=1 the API trusts an X-Edge-User header instead of a JWT.
# Never set this in production — it makes every account impersonable by a header.
EDGE_DEV=

# --- Payments ----------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Projections -------------------------------------------------------------------
# sleeper (default, free, no key) | tank01 (needs TANK01_API_KEY)
EDGE_PROJECTION_PROVIDER=sleeper
TANK01_API_KEY=

# --- Written trade explanations (optional) -----------------------------------------
# Off by default: explanations come from templates and nothing leaves the server.
# EDGE_USE_CLAUDE=1 sends the verdict's numbers and player names to Anthropic.
EDGE_USE_CLAUDE=
EDGE_CLAUDE_MODEL=claude-opus-5
ANTHROPIC_API_KEY=

# --- Share-card rendering (optional) -----------------------------------------------
# Path to a Chromium binary, if the bundled Playwright one is not where it is expected.
EDGE_CHROMIUM=
