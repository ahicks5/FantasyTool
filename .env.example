# Edge API (edge/) — copy to .env and fill in. Nothing here is required to run the
# tests, which are offline against fixtures; the API itself runs with all of it unset.
# Secrets belong in the host's environment settings (Railway/Render), never in git.

# --- Where things live -------------------------------------------------------------
# Public URL of the web app. Used for share links, and to decide which checkout return
# URLs are ours — an off-origin one is refused, so this must be right in production.
EDGE_WEB_URL=http://localhost:3000
# Comma-separated allowed browser origins. Leave unset in dev; in production set it to
# your web domain. It defaults to "*", which you do not want facing the internet.
EDGE_CORS=http://localhost:3000
# SQLite file holding purchases, connected leagues, runs and feedback.
EDGE_DB=.cache/edge.db
# Disk cache for the Sleeper player list, projections and rendered share cards.
EDGE_CACHE_DIR=.cache

# --- Season ------------------------------------------------------------------------
EDGE_SEASON=2026

# --- Auth --------------------------------------------------------------------------
# Supabase JWT signing secret; the API verifies the browser's bearer token with it.
# Without it, a signed-in request is rejected with a 500 rather than trusted.
SUPABASE_JWT_SECRET=
# Dev only: with EDGE_DEV=1 the API trusts an X-Edge-User header instead of a JWT.
# Never set this in production — it makes every account impersonable by a header.
EDGE_DEV=

# --- Payments ----------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Projections -------------------------------------------------------------------
# sleeper (default, free, no key) | tank01 (needs TANK01_API_KEY)
EDGE_PROJECTION_PROVIDER=sleeper
TANK01_API_KEY=

# --- Written trade explanations (optional) -----------------------------------------
# Off by default: explanations come from templates and nothing leaves the server.
# EDGE_USE_CLAUDE=1 sends the verdict's numbers and player names to Anthropic.
EDGE_USE_CLAUDE=
EDGE_CLAUDE_MODEL=claude-opus-5
ANTHROPIC_API_KEY=

# --- Share-card rendering (optional) -----------------------------------------------
# Path to a Chromium binary, if the bundled Playwright one is not where it is expected.
EDGE_CHROMIUM=
